# Copia este archivo como .env.local (ese sí es el que se usa de verdad,
# y NUNCA se sube a ningún sitio porque está en .gitignore) y rellena
# los valores reales.

# Supabase — mismo proyecto que ya usa la app interna de gestión.
# La anon key es pública por diseño (protegida por RLS), la misma que ya
# estaba en producción en el sistema de reservas anterior (Netlify).
NEXT_PUBLIC_SUPABASE_URL=https://lkvhmhcapcdnadptkpau.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxrdmhtaGNhcGNkbmFkcHRrcGF1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAzODQ4NjcsImV4cCI6MjA5NTk2MDg2N30.VGfuZ_MVs6jytE_DWOhK8B5__zRw7b6i-F_j0qC9Kz4

# Stripe — clave SECRETA (empieza por sk_...), NO la de los Payment Links.
# Se saca de: dashboard.stripe.com > Developers > API keys.
# Sin esto, el carrito sigue funcionando: cae automáticamente a WhatsApp.
STRIPE_SECRET_KEY=

# Stripe Webhook — secreto de firma (empieza por whsec_...).
# Se saca al crear el endpoint en dashboard.stripe.com > Developers > Webhooks,
# apuntando a: https://tudominio.com/api/webhooks/stripe
# Evento a escuchar: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Resend — para el envío automático del bono en PDF por email.
RESEND_API_KEY=
# Email verificado en Resend desde el que se envía (si no lo tienes propio
# verificado todavía, puedes dejar sin rellenar y usará onboarding@resend.dev
# — funciona para pruebas, pero para producción conviene tu propio dominio).
RESEND_FROM_EMAIL=
# Opcional: tu email, para recibir copia de cada bono vendido.
BUSINESS_NOTIFICATION_EMAIL=

# Google Places API — para las reseñas automáticas en la home.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
